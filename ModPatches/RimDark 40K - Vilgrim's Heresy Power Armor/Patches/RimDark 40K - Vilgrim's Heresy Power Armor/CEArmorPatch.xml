	</Operation>

    <!-- ===== MkIII Helmet ====== -->
    <Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="qwezxc_MkIIIHelmet"]/statBases/Mass</xpath>
		<value>
			<Mass>25</Mass>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[@Name="qwezxc_MkIIIHelmet"]/statBases</xpath>
		<value>
			<Bulk>15</Bulk>
			<WornBulk>5</WornBulk>
            <NightVisionEfficiency_Apparel>0.6</NightVisionEfficiency_Apparel>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="qwezxc_MkIIIHelmet"]/statBases/ArmorRating_Sharp</xpath>

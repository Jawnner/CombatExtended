<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Remove Head Armor Statbases-->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="qwezxc_MkIIIHelmet" or
			defName="qwezxc_MkIVPowerArmorHelmet" or
			defName="qwezxc_MkVIPowerArmorHelmet"]/statBases/ArmorRating_Sharp</xpath>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="qwezxc_MkIIIHelmet" or
			defName="qwezxc_MkIVPowerArmorHelmet" or
			defName="qwezxc_MkVIPowerArmorHelmet"]/statBases/ArmorRating_Blunt</xpath>
	</Operation>


	<!-- Remove Body Armor Statbases-->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="qwezxc_MkIIIPowerArmor" or
